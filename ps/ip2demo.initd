#!/bin/sh
### BEGIN INIT INFO
# Provides:          ip2demo
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: IP2 低小目标检测 实时预览
### END INIT INFO

BIN=/lib/firmware/ip2_bd_wrapper.bin
BIT=/lib/firmware/ip2_bd_wrapper.bit
FWM=/sys/class/fpga_manager/fpga0
DIR=/root/ip2
LOG=/var/log/ip2demo.log

start() {
    echo "== ip2demo start $(date) ==" >> $LOG
    # 1) 加载 PL 位流（有 .bin 优先用 fpga_manager，否则提示用 xsct）
    if [ -f "$BIN" ]; then
        echo ip2_bd_wrapper.bin > $FWM/firmware 2>>$LOG
        echo "fpga_manager load rc=$? state=$(cat $FWM/state)" >> $LOG
    else
        echo "WARN: $BIN 不存在，PL 可能未配置（可用 xsct 烧 .bit）" >> $LOG
    fi
    sleep 1
    # 2) 起预览服务
    cd $DIR || exit 1
    setsid nohup python3 -u cam_demo.py --port 8080 >> $LOG 2>&1 < /dev/null &
    echo $! > /var/run/ip2demo.pid
    echo "server pid=$(cat /var/run/ip2demo.pid)" >> $LOG
}

stop() {
    if [ -f /var/run/ip2demo.pid ]; then
        kill $(cat /var/run/ip2demo.pid) 2>/dev/null
        rm -f /var/run/ip2demo.pid
    fi
    pkill -f 'cam_demo[.]py' 2>/dev/null
    echo "ip2demo stopped $(date)" >> $LOG
}

case "$1" in
    start)   start ;;
    stop)    stop ;;
    restart) stop; sleep 1; start ;;
    status)  ps | grep -c '[c]am_demo' ;;
    *) echo "用法: $0 {start|stop|restart|status}"; exit 1 ;;
esac
