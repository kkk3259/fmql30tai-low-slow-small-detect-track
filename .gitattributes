

# ============================================================
# 强制 shell 脚本使用 LF 换行
# 背景：2026-10-29 发现 /etc/init.d/ip2demo 被 Windows 编辑成 CRLF，
#      导致 shebang 变成 "#!/bin/sh\r"，内核 execve 报
#      "No such file or directory" + systemd status=203/EXEC，
#      服务启动失败但文件明明存在。同理影响所有板端 shell 脚本。
# ============================================================
*.sh              text eol=lf
ps/ip2demo.init   text eol=lf
ps/ip2demo.initd  text eol=lf
*.init            text eol=lf
*.initd           text eol=lf
tools/*.sh        text eol=lf

# Python 脚本也统一 LF（避免 python3 在板上因 CRLF 出问题）
*.py              text eol=lf
