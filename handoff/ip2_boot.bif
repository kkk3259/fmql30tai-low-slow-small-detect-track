// ============================================================================
// 我们的 BOOT.bin 打包清单（bif）
// 用法：Procise → Tools → Create Image（不要用原版 Xilinx bootgen，
//       官方 bif 头是 //arch = fmql，是复旦微的变体）
//
// 五件东西的来历：
//   ① FSBL.elf            ← **必须新做**：SDK 用 handoff/ip2_bd_wrapper.hdf 建 FSBL 工程编译
//                             （旧的 FSBL 不认识我们的 GP1/HP0 配置）
//   ② ip2_bd_wrapper.bit  ← 本次 Vivado 产出，就在 handoff/ip2_bd_wrapper.hdf 里
//   ③ bl31.elf            ← 官方原件：dl/bootgen/x/BOOT_Gen/bl31.elf
//   ④ u-boot              ← 官方原件：dl/bootgen/x/BOOT_Gen/u-boot（ELF 头 7F 45 4C 46）
//   ⑤ fsbl_config         ← 保持 apu_x32
// ============================================================================

//arch = fmql; split = false; format = BIN
the_ROM_image:
{
	[bootloader, destination_device = ps]D:/firstharness/repo/handoff/fsbl/ip2_fsbl.elf
	[destination_device = pl]D:/firstharness/repo/handoff/ip2_bd_wrapper.bit
	[destination_cpu = apu_0, destination_device = ps]D:/firstharness/dl/bootgen/x/BOOT_Gen/bl31.elf
	[destination_cpu = apu_0, destination_device = ps]D:/firstharness/dl/bootgen/x/BOOT_Gen/u-boot
	[fsbl_config]apu_x32
}
